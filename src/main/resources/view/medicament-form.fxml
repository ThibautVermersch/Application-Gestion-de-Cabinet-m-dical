<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.univartois.butinfo.sae.cabinet.controller.MedicamentFormController">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label fx:id="labelTitre" text="Ajouter un médicament"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="12" vgap="10">

        <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="champNom" prefWidth="250"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Prix (€) :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="champPrix" promptText="ex: 5.99"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Description :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="champDescription"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    </GridPane>

    <Label fx:id="labelErreur" style="-fx-text-fill: red;" text=""/>

    <HBox spacing="10">
        <Button text="Valider"  onAction="#valider"/>
        <Button text="Annuler" onAction="#annuler"/>
    </HBox>

</VBox>
