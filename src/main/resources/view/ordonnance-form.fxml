<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.univartois.butinfo.sae.cabinet.controller.OrdonnanceFormController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label fx:id="lblTitreFormulaire" text="Nouvelle Ordonnance / Modification">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <Label text="Informations générales">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <GridPane hgap="15.0" vgap="10.0">
                    <children>
                        <Label text="Médecin prescripteur :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="cmbMedecin" prefWidth="250.0" promptText="Choisir un médecin"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Patient concerné :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox fx:id="cmbPatient" prefWidth="250.0" promptText="Choisir un patient"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Date de début :" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <!-- CORRECTION 2 : fx:id était "dateDebut", doit être "dpDateEmission" -->
                        <DatePicker fx:id="dpDateEmission" prefWidth="200.0"
                                    GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Valide jusqu'au :" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <DatePicker fx:id="dpDateValidite" prefWidth="200.0"
                                    GridPane.columnIndex="3" GridPane.rowIndex="1" />
                    </children>
                </GridPane>

                <Label text="Médicaments à prescrire">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Médicament" />
                                <ComboBox fx:id="cmbMedicament" prefWidth="180.0" promptText="Sélectionner" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Quantité" />
                                <Spinner fx:id="spnQuantite" editable="true" prefWidth="80.0" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Durée (jours)" />
                                <Spinner fx:id="spnDuree" editable="true" prefWidth="90.0" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Posologie" />
                                <TextField fx:id="txtPosologie" prefWidth="150.0" promptText="Ex: 1 matin / 1 soir" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Instructions" />
                                <TextField fx:id="txtInstructions" prefWidth="200.0" promptText="Ex: Au milieu du repas" />
                            </children>
                        </VBox>
                        <Button fx:id="btnAjouterLigne" mnemonicParsing="false"
                                onAction="#ajouterLignePrescription" text="Ajouter" />
                    </children>
                </HBox>

                <TableView fx:id="tableViewPrescriptionsForm" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFormMedicament" prefWidth="180.0" text="Médicament" />
                        <TableColumn fx:id="colFormQuantite" prefWidth="80.0" text="Quantité" />
                        <TableColumn fx:id="colFormDuree" prefWidth="90.0" text="Durée (jours)" />
                        <TableColumn fx:id="colFormPosologie" prefWidth="180.0" text="Posologie" />
                        <TableColumn fx:id="colFormInstructions" prefWidth="200.0" text="Instructions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="TOP_RIGHT">
                    <children>
                        <Button fx:id="btnSupprimerLigne" mnemonicParsing="false"
                                onAction="#supprimerLignePrescription" text="Retirer le médicament sélectionné" />
                    </children>
                </HBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Remarques particulières :" />
                        <TextArea fx:id="txtFormRemarques" prefHeight="60.0" wrapText="true"
                                  promptText="Ajouter un commentaire ou des consignes spécifiques pour le pharmacien..." />
                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label fx:id="lblErreur" text="" style="-fx-text-fill: red; -fx-font-size: 13px;" />
                <Button fx:id="btnAnnuler" mnemonicParsing="false" onAction="#annulerSaisie"
                        text="Annuler" prefWidth="100.0" />
                <Button fx:id="btnEnregistrer" mnemonicParsing="false" onAction="#enregistrerOrdonnance"
                        text="Enregistrer" prefWidth="100.0" />
            </children>
        </HBox>
    </bottom>

</BorderPane>
