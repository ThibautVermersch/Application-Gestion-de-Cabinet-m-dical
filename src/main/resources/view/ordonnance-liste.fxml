<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- CORRECTION : xmlns:fx corrigé (http://fxml.com → http://javafx.com/fxml/1) -->
<BorderPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.univartois.butinfo.sae.cabinet.controller.OrdonnanceListController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <Label text="Gestion des Ordonnances">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Label fx:id="lblErreur" text="" style="-fx-text-fill: #e80000; -fx-font-size: 13px;" />
            </children>
        </HBox>
    </top>

    <center>
        <HBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <VBox spacing="10.0" prefWidth="300.0">
                    <children>
                        <Label text="Liste des Ordonnances">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <ListView fx:id="listViewOrdonnances" VBox.vgrow="ALWAYS" />

                        <HBox spacing="10.0" alignment="CENTER">
                            <children>
                                <Button fx:id="btnAjouter" mnemonicParsing="false"
                                        onAction="#ouvrirFormulaireAjout" text="Créer" prefWidth="80.0" />
                                <Button fx:id="btnModifier" mnemonicParsing="false"
                                        onAction="#ouvrirFormulaireModification" text="Modifier" prefWidth="80.0" />
                                <Button fx:id="btnSupprimer" mnemonicParsing="false"
                                        onAction="#supprimerOrdonnance" text="Supprimer" prefWidth="80.0" />

                            </children>

                        </HBox>
                    </children>
                    <HBox spacing="10.0" alignment="CENTER">
                    <Button fx:id="btnRetourAccueil" mnemonicParsing="false"
                            onAction="#retourAccueil" text="← Retour accueil" /></HBox>
                </VBox>

                <Separator orientation="VERTICAL" prefHeight="200.0" />

                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Détails de l'Ordonnance">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <GridPane hgap="10.0" vgap="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <Label text="Numéro (ID) :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="lblId" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Médecin prescripteur :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Label fx:id="lblMedecin" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Patient concerné :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <Label fx:id="lblPatient" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Date d'émission :" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <Label fx:id="lblDateEmission" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Valide jusqu'au :" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <Label fx:id="lblDateValidite" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Label text="Coût total estimé :" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                <Label fx:id="lblPrixTotal" text="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            </children>
                        </GridPane>

                        <Label text="Médicaments prescrits :">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>

                        <TableView fx:id="tableViewPrescriptions" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colMedicament" prefWidth="150.0" text="Médicament" />
                                <TableColumn fx:id="colQuantite" prefWidth="75.0" text="Quantité" />
                                <TableColumn fx:id="colDuree" prefWidth="75.0" text="Durée (jours)" />
                                <TableColumn fx:id="colPosologie" prefWidth="150.0" text="Posologie" />
                                <TableColumn fx:id="colInstructions" prefWidth="150.0" text="Instructions complémentaires" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Remarques :" />
                                <TextArea fx:id="txtRemarques" editable="false" prefHeight="70.0" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

</BorderPane>
