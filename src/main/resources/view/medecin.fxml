<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.4" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controller.MedecinListeController">
    <items>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label text="Liste des Médecins" style="-fx-font-weight: bold;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <ListView fx:id="listeMedecins" VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#addMedecin" text="Ajouter" />
                        <Button mnemonicParsing="false" onAction="#modifMedecin" text="Modifier" />
                        <Button mnemonicParsing="false" onAction="#delMedecin" text="Supprimer" />
                    </children>
                </HBox>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#retourAccueil" text="Retour Accueil" style="-fx-background-color: #e0e0e0;" />
            </children>
        </VBox>

        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="Détails du Médecin" style="-fx-font-weight: bold;">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <Separator />

                <GridPane hgap="10.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Nom complet :" GridPane.rowIndex="0" />
                        <Label fx:id="labelNomComplet" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Spécialité :" GridPane.rowIndex="1" />
                        <Label fx:id="labelSpecialite" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Téléphone :" GridPane.rowIndex="2" />
                        <Label fx:id="labelTelephone" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Email :" GridPane.rowIndex="3" />
                        <Label fx:id="labelEmail" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Tarif horaire :" GridPane.rowIndex="4" />
                        <Label fx:id="labelTarif" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="N° Ordre :" GridPane.rowIndex="5" />
                        <Label fx:id="labelNumeroOrdre" textFill="#797979" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    </children>
                </GridPane>
            </children>
        </VBox>
    </items>
</SplitPane>