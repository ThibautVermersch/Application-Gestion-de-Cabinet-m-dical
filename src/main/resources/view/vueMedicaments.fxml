<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="20"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.univartois.butinfo.sae.cabinet.controller.MedicamentControleur">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="10" prefWidth="250">
        <Label text="Liste des médicaments" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

        <ListView fx:id="listeMedicaments" prefHeight="400"/>

        <HBox spacing="8">
            <Button text="Ajouter"    onAction="#ajouterMedicament"/>
            <Button text="Modifier"   onAction="#modifierMedicament"/>
            <Button text="Supprimer"  onAction="#supprimerMedicament"/>
        </HBox>

        <Button text="Retour accueil" onAction="#retourAccueil" prefWidth="250"/>
    </VBox>

    <Separator orientation="VERTICAL"/>

    <VBox spacing="10" prefWidth="350">
        <Label text="Détails du médicament" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

        <GridPane hgap="10" vgap="12">
            <Label text="Nom :"           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="labelNom"       GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-weight: bold;"/>

            <Label text="Prix :"          GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="labelPrix"      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Description :"   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="labelDescription" GridPane.rowIndex="2" GridPane.columnIndex="1" wrapText="true"/>

            <Label text="ID Système :"    GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: gray;"/>
            <Label fx:id="labelId"        GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: gray;"/>
        </GridPane>
    </VBox>

</HBox>