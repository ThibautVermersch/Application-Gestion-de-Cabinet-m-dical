<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1.7976931348623157E308"
      maxWidth="1.7976931348623157E308" spacing="20.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.univartois.butinfo.sae.cabinet.controller.MedecinController">
    <children>
        <TextField fx:id="nom" maxWidth="1.7976931348623157E308" promptText="Nom" />
        <TextField fx:id="prenom" maxWidth="1.7976931348623157E308" promptText="Prénom" />
        <TextField fx:id="telephone" maxWidth="1.7976931348623157E308" promptText="Téléphone" />
        <TextField fx:id="email" maxWidth="1.7976931348623157E308" promptText="Email" />
        <TextField fx:id="numeroOrdre" maxWidth="1.7976931348623157E308" promptText="N° Ordre" />
        <ComboBox fx:id="specialite" maxWidth="1.7976931348623157E308" promptText="Spécialité" />
        <TextField fx:id="tarif" maxWidth="1.7976931348623157E308" promptText="Tarif (€)" />
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button mnemonicParsing="false" onAction="#valider" text="OK" />
                <Button mnemonicParsing="false" onAction="#annuler" text="Annuler" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>