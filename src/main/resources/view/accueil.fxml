<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- 
    fx:controller : on indique quelle classe Java gère cette vue.
    VBox : une boîte qui empile les éléments verticalement.
    spacing="15" : 15 pixels d'espace entre chaque élément.
    alignment="CENTER" : tout est centré.
-->
<VBox spacing="15" alignment="CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.univartois.butinfo.sae.cabinet.controller.AccueilControleur">

    <padding>
        <Insets top="40" right="60" bottom="40" left="60"/>
    </padding>

    <!-- Titre de l'application -->
    <Label text="Cabinet Médical — Accueil"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <!-- Un bouton par vue. onAction : méthode appelée dans le contrôleur. -->
    <Button text="👤  Gérer les Patients"
            prefWidth="250"
            onAction="#ouvrirPatients"/>

    <!-- Tu pourras décommenter ces boutons quand tu auras créé les autres vues -->
    <!--
    <Button text="🩺  Gérer les Médecins"    prefWidth="250" onAction="#ouvrirMedecins"/>
    <Button text="💊  Gérer les Médicaments" prefWidth="250" onAction="#ouvrirMedicaments"/>
    <Button text="📅  Gérer les Rendez-Vous" prefWidth="250" onAction="#ouvrirRendezVous"/>
    <Button text="📋  Gérer les Ordonnances" prefWidth="250" onAction="#ouvrirOrdonnances"/>
    -->

</VBox>
